# Environment variables Axdio reads (all optional). Pass them with `environment:` in docker-compose.yml
# or `env_file: .env`.

# Folders inside the container
CFG_DIR_MUSIC=/music
CONFIG_DIR=/app/config
# Private messages and their encrypted attachments (default: $CONFIG_DIR/chat). Mount a folder here to keep them apart.
# CHAT_DIR=/chat

# Port the server listens on
PORT=7865

# User and group the server runs as (owner of your config folder). 0 = root.
PUID=1000
PGID=1000

# Signs sessions and encrypts app passwords. Leave unset to generate one in config/secret_key.
# SECRET_KEY=

# Concurrent requests (each streaming listener holds one)
WEB_THREADS=48

# debug | info | warning | error
LOG_LEVEL=info

# true = log every request
ACCESS_LOG=false

# Extra pip options for installing plugins, e.g. behind a mirror:
# PLUGIN_PIP_ARGS=--index-url https://pypi.example.com/simple
